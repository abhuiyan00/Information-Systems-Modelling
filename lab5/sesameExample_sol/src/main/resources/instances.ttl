# ═════════════════════════════════════════════
#  BUILDS  (8)
# ═════════════════════════════════════════════

inst:build1
    rdf:type            mc:DroneBuild ;
    mc:buildTitle       "ImpulseRC Apex 5\" FPV Freestyle Drone" ;
    mc:buildDescription "Full custom 5-inch freestyle build on ImpulseRC Apex frame. T-Motor F40 Pro IV 2306 motors, Hobbywing XRotor 45A ESC stack, Kakute H7 v2 FC. Tuned BetaFlight 4.4." ;
    mc:createdBy        inst:user1 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "95"^^xsd:integer .

inst:build2
    rdf:type            mc:DroneBuild ;
    mc:buildTitle       "DJI Avata 2 Long-Range Cinema Setup" ;
    mc:buildDescription "DJI Avata 2 with ND filter kit and custom foam case. Extended battery mod for 23 min flight time. Used for real-estate aerial photography." ;
    mc:createdBy        inst:user4 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "88"^^xsd:integer .

inst:build3
    rdf:type            mc:RCCarBuild ;
    mc:buildTitle       "Traxxas XO-1 200km/h Build" ;
    mc:buildDescription "Traxxas XO-1 fully upgraded: Velineon 3500 motor, LiPo 6S, aluminium chassis braces, RPM rear bumper. Verified 200 km/h on GPS." ;
    mc:createdBy        inst:user2 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "97"^^xsd:integer .

inst:build4
    rdf:type            mc:RobotBuild ;
    mc:buildTitle       "Autonomous Line-Following Robot v3" ;
    mc:buildDescription "Raspberry Pi 5-based autonomous robot with PID line-following, ultrasonic obstacle avoidance, and OLED telemetry display." ;
    mc:createdBy        inst:user6 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "82"^^xsd:integer .

inst:build5
    rdf:type            mc:AircraftBuild ;
    mc:buildTitle       "Radian Pro 2m Glider Thermal Build" ;
    mc:buildDescription "E-flite Radian Pro 2m ARF with upgraded Spektrum AR8020T receiver, SAFE Select technology. Perfect thermal soaring platform." ;
    mc:createdBy        inst:user7 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "90"^^xsd:integer .

inst:build6
    rdf:type            mc:BoatBuild ;
    mc:buildTitle       "Pro Boat Miss Geico 17\" Catamaran" ;
    mc:buildDescription "Pro Boat Miss Geico with brushless Dynamite 3900Kv motor upgrade. Capable of 65 km/h on flat water. Custom paint scheme." ;
    mc:createdBy        inst:user8 ;
    mc:hasStatus        mc:SubmittedStatus ;
    mc:hasScore         "0"^^xsd:integer .

inst:build7
    rdf:type            mc:DroneBuild ;
    mc:buildTitle       "3\" Toothpick Micro Quad Long Range" ;
    mc:buildDescription "3-inch ultralight toothpick build. ELRS 2.4GHz, 4-in-1 20x20 stack, GoPro Session 5 mounted. Sub-250g without battery." ;
    mc:createdBy        inst:user1 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "78"^^xsd:integer .

inst:build8
    rdf:type            mc:RCCarBuild ;
    mc:buildTitle       "Kyosho Inferno MP10e 1/8 Buggy" ;
    mc:buildDescription "Kyosho Inferno MP10e electric buggy. Orion Vortex R10 ESC, Reedy 2050Kv motor, upgraded oil-filled shocks, full ball-bearing kit." ;
    mc:createdBy        inst:user10 ;
    mc:hasStatus        mc:ApprovedStatus ;
    mc:hasScore         "85"^^xsd:integer .

