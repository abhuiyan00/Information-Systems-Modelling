{
  "comment": "Reusable JSON-LD @context for the ModellingClub custom vocabulary (mc:). Pairs with schema.org as the default vocabulary. Full TBox lives in lab5/sesameExample_sol/src/main/resources/ontology.ttl.",
  "@context": {
    "@vocab": "https://schema.org/",
    "schema": "https://schema.org/",
    "mc":  "http://modellingclub.local/ontology#",
    "mcr": "http://modellingclub.local/resource/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "DroneBuild":        "mc:DroneBuild",
    "RCCarBuild":        "mc:RCCarBuild",
    "RobotBuild":        "mc:RobotBuild",
    "AircraftBuild":     "mc:AircraftBuild",
    "BoatBuild":         "mc:BoatBuild",
    "FlightLog":         "mc:FlightLog",
    "TelemetryRecord":   "mc:TelemetryRecord",
    "TestRun":           "mc:TestRun",
    "MarketplaceListing":"mc:MarketplaceListing",
    "ReputationRecord":  "mc:ReputationRecord",
    "Community":         "mc:Community",

    "buildTitle":        "mc:buildTitle",
    "buildDescription":  "mc:buildDescription",
    "hasStatus":         { "@id": "mc:hasStatus", "@type": "@id" },
    "hasScore":          { "@id": "mc:hasScore", "@type": "xsd:integer" },
    "createdBy":         { "@id": "mc:createdBy", "@type": "@id" },
    "hasFlightLog":      { "@id": "mc:hasFlightLog", "@type": "@id" },
    "flightAltitude":    { "@id": "mc:flightAltitude", "@type": "xsd:decimal" },
    "pilotLicenseId":    "mc:pilotLicenseId",
    "hasTelemetry":      { "@id": "mc:hasTelemetry", "@type": "@id" },
    "topSpeed":          { "@id": "mc:topSpeed", "@type": "xsd:decimal" },
    "maxRange":          { "@id": "mc:maxRange", "@type": "xsd:decimal" },
    "crashCount":        { "@id": "mc:crashCount", "@type": "xsd:integer" },
    "partName":          "mc:partName",
    "askingPrice":       { "@id": "mc:askingPrice", "@type": "xsd:decimal" },
    "partCategory":      { "@id": "mc:partCategory", "@type": "@id" },
    "listedBy":          { "@id": "mc:listedBy", "@type": "@id" },
    "organisedBy":       { "@id": "mc:organisedBy", "@type": "@id" },
    "attendedBy":        { "@id": "mc:attendedBy", "@type": "@id" },
    "testRunLocation":   "mc:testRunLocation",
    "testRunDate":       { "@id": "mc:testRunDate", "@type": "xsd:dateTime" },
    "hasReputation":     { "@id": "mc:hasReputation", "@type": "@id" },
    "builderScore":      { "@id": "mc:builderScore", "@type": "xsd:integer" },
    "helperScore":       { "@id": "mc:helperScore", "@type": "xsd:integer" },
    "organiserScore":    { "@id": "mc:organiserScore", "@type": "xsd:integer" },
    "reliabilityScore":  { "@id": "mc:reliabilityScore", "@type": "xsd:integer" },
    "username":          "mc:username",
    "registeredAt":      { "@id": "mc:registeredAt", "@type": "xsd:dateTime" },
    "knows":             { "@id": "mc:knows", "@type": "@id" },
    "isMemberOf":        { "@id": "mc:isMemberOf", "@type": "@id" },
    "isSubCommunityOf":  { "@id": "mc:isSubCommunityOf", "@type": "@id" }
  }
}
