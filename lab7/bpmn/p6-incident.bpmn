<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p6_incident" targetNamespace="http://modellingclub.local/bpmn" exporter="ModellingClub Lab7 generator" exporterVersion="1.0">
  <bpmn:dataStore id="STORE_DS_AUDIT" name="Audit log"/>
  <bpmn:collaboration id="Collab_p6_incident">
    <bpmn:participant id="Part_POOL_OPS" name="ModellingClub Operations" processRef="Proc_POOL_OPS"/>
    <bpmn:participant id="Part_POOL_USERS" name="Affected Users"/>
    <bpmn:participant id="Part_POOL_REG" name="Supervisory Authority / Regulator"/>
    <bpmn:messageFlow id="Msg_p6_incident_0" name="Incident alert &amp; re-login notice" sourceRef="NOTIFY_USERS" targetRef="Part_POOL_USERS"/>
    <bpmn:messageFlow id="Msg_p6_incident_1" name="GDPR Art. 33 breach notification" sourceRef="NOTIFY_REG" targetRef="Part_POOL_REG"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_POOL_OPS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POOL_OPS">
      <bpmn:lane id="Lane_POOL_OPS_0" name="Monitoring &amp; SIEM"><bpmn:flowNodeRef>START_SIGNAL</bpmn:flowNodeRef><bpmn:flowNodeRef>ENRICH_TRIAGE</bpmn:flowNodeRef><bpmn:flowNodeRef>LOG_LOW</bpmn:flowNodeRef><bpmn:flowNodeRef>END_LOW</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_OPS_1" name="Security On-Call"><bpmn:flowNodeRef>GW_SEVERITY</bpmn:flowNodeRef><bpmn:flowNodeRef>ASSESS_HIGH</bpmn:flowNodeRef><bpmn:flowNodeRef>BND_ESCALATE</bpmn:flowNodeRef><bpmn:flowNodeRef>NOTIFY_TEAM</bpmn:flowNodeRef><bpmn:flowNodeRef>END_HIGH</bpmn:flowNodeRef><bpmn:flowNodeRef>PAR_CONTAIN</bpmn:flowNodeRef><bpmn:flowNodeRef>NOTIFY_USERS</bpmn:flowNodeRef><bpmn:flowNodeRef>VERIFY_RECOVERY</bpmn:flowNodeRef><bpmn:flowNodeRef>POST_MORTEM</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_HARDEN</bpmn:flowNodeRef><bpmn:flowNodeRef>CREATE_TASK</bpmn:flowNodeRef><bpmn:flowNodeRef>END_CRITICAL</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_OPS_2" name="System"><bpmn:flowNodeRef>APPLY_MIT</bpmn:flowNodeRef><bpmn:flowNodeRef>ROTATE_JWT</bpmn:flowNodeRef><bpmn:flowNodeRef>BLOCK_IPS</bpmn:flowNodeRef><bpmn:flowNodeRef>MAINT_MODE</bpmn:flowNodeRef><bpmn:flowNodeRef>PAR_CONTAIN_JOIN</bpmn:flowNodeRef><bpmn:flowNodeRef>ERADICATE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_OPS_3" name="DPO &amp; Legal"><bpmn:flowNodeRef>GW_BREACH</bpmn:flowNodeRef><bpmn:flowNodeRef>NOTIFY_DPO</bpmn:flowNodeRef><bpmn:flowNodeRef>TIMER_72H</bpmn:flowNodeRef><bpmn:flowNodeRef>NOTIFY_REG</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START_SIGNAL" name="SIEM alert received"><bpmn:signalEventDefinition/></bpmn:startEvent>
    <bpmn:serviceTask id="ENRICH_TRIAGE" name="Enrich alert: correlate logs, IPs, accounts"/>
    <bpmn:exclusiveGateway id="GW_SEVERITY" name="Severity level?"/>
    <bpmn:scriptTask id="LOG_LOW" name="Log event; raise threshold"/>
    <bpmn:endEvent id="END_LOW" name="Closed — low severity"></bpmn:endEvent>
    <bpmn:manualTask id="ASSESS_HIGH" name="Assess scope &amp; data-exposure risk"/>
    <bpmn:boundaryEvent id="BND_ESCALATE" name="1h escalation" attachedToRef="ASSESS_HIGH" cancelActivity="false"><bpmn:timerEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="APPLY_MIT" name="Apply mitigations (block IPs, revoke sessions)"/>
    <bpmn:sendTask id="NOTIFY_TEAM" name="Notify team &amp; management"/>
    <bpmn:endEvent id="END_HIGH" name="High incident closed"></bpmn:endEvent>
    <bpmn:parallelGateway id="PAR_CONTAIN" name="Begin containment"/>
    <bpmn:serviceTask id="ROTATE_JWT" name="Rotate JWT secret (forces re-login)"/>
    <bpmn:serviceTask id="BLOCK_IPS" name="Block IPs / rate-limit /auth/login"/>
    <bpmn:serviceTask id="MAINT_MODE" name="Optionally engage maintenance mode"/>
    <bpmn:parallelGateway id="PAR_CONTAIN_JOIN" name="Containment complete"/>
    <bpmn:exclusiveGateway id="GW_BREACH" name="Personal data exposed?"/>
    <bpmn:sendTask id="NOTIFY_DPO" name="Notify DPO; start breach assessment"/>
    <bpmn:sendTask id="NOTIFY_USERS" name="Notify affected users (re-login)"/>
    <bpmn:intermediateCatchEvent id="TIMER_72H" name="72h GDPR deadline"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="NOTIFY_REG" name="Submit breach notification"/>
    <bpmn:serviceTask id="ERADICATE" name="Eradicate threat; harden config"/>
    <bpmn:manualTask id="VERIFY_RECOVERY" name="Verify recovery; monitor recurrence"/>
    <bpmn:manualTask id="POST_MORTEM" name="Post-incident review"/>
    <bpmn:exclusiveGateway id="GW_HARDEN" name="Hardening task needed?"/>
    <bpmn:manualTask id="CREATE_TASK" name="Create follow-up hardening task"/>
    <bpmn:endEvent id="END_CRITICAL" name="Incident closed"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p6_incident_0" sourceRef="START_SIGNAL" targetRef="ENRICH_TRIAGE"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_1" sourceRef="ENRICH_TRIAGE" targetRef="GW_SEVERITY"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_2" name="low" sourceRef="GW_SEVERITY" targetRef="LOG_LOW"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_3" name="high" sourceRef="GW_SEVERITY" targetRef="ASSESS_HIGH"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_4" name="critical" sourceRef="GW_SEVERITY" targetRef="PAR_CONTAIN"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_5" sourceRef="LOG_LOW" targetRef="END_LOW"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_6" sourceRef="ASSESS_HIGH" targetRef="APPLY_MIT"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_7" sourceRef="APPLY_MIT" targetRef="NOTIFY_TEAM"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_8" sourceRef="NOTIFY_TEAM" targetRef="END_HIGH"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_9" name="escalate" sourceRef="BND_ESCALATE" targetRef="PAR_CONTAIN"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_10" sourceRef="PAR_CONTAIN" targetRef="ROTATE_JWT"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_11" sourceRef="PAR_CONTAIN" targetRef="BLOCK_IPS"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_12" sourceRef="PAR_CONTAIN" targetRef="MAINT_MODE"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_13" sourceRef="ROTATE_JWT" targetRef="PAR_CONTAIN_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_14" sourceRef="BLOCK_IPS" targetRef="PAR_CONTAIN_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_15" sourceRef="MAINT_MODE" targetRef="PAR_CONTAIN_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_16" sourceRef="PAR_CONTAIN_JOIN" targetRef="GW_BREACH"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_17" name="yes" sourceRef="GW_BREACH" targetRef="NOTIFY_DPO"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_18" name="no" sourceRef="GW_BREACH" targetRef="ERADICATE"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_19" sourceRef="NOTIFY_DPO" targetRef="NOTIFY_USERS"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_20" sourceRef="NOTIFY_USERS" targetRef="TIMER_72H"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_21" sourceRef="TIMER_72H" targetRef="NOTIFY_REG"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_22" sourceRef="NOTIFY_REG" targetRef="ERADICATE"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_23" sourceRef="ERADICATE" targetRef="VERIFY_RECOVERY"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_24" sourceRef="VERIFY_RECOVERY" targetRef="POST_MORTEM"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_25" sourceRef="POST_MORTEM" targetRef="GW_HARDEN"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_26" name="yes" sourceRef="GW_HARDEN" targetRef="CREATE_TASK"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_27" name="no" sourceRef="GW_HARDEN" targetRef="END_CRITICAL"/>
    <bpmn:sequenceFlow id="Flow_p6_incident_28" sourceRef="CREATE_TASK" targetRef="END_CRITICAL"/>
    <bpmn:dataStoreReference id="DS_AUDIT" name="Audit log" dataStoreRef="STORE_DS_AUDIT"/>
    <bpmn:association id="Assoc_DS_AUDIT" sourceRef="ENRICH_TRIAGE" targetRef="DS_AUDIT"/>
    <bpmn:dataObject id="OBJ_DO_BREACH"/>
    <bpmn:dataObjectReference id="DO_BREACH" name="Breach assessment" dataObjectRef="OBJ_DO_BREACH"/>
    <bpmn:association id="Assoc_DO_BREACH" sourceRef="NOTIFY_DPO" targetRef="DO_BREACH"/>
    <bpmn:textAnnotation id="Anno_POOL_OPS_0"><bpmn:text>HS256 rotation invalidates all 24h tokens</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_OPS_0" sourceRef="ROTATE_JWT" targetRef="Anno_POOL_OPS_0"/>
    <bpmn:textAnnotation id="Anno_POOL_OPS_1"><bpmn:text>No on-call response in 1h → escalate to critical</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_OPS_1" sourceRef="BND_ESCALATE" targetRef="Anno_POOL_OPS_1"/>
  </bpmn:process>
