<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p2_upgrade" targetNamespace="http://modellingclub.local/bpmn" exporter="ModellingClub Lab7 generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_p2_upgrade">
    <bpmn:participant id="Part_POOL_ENG" name="ModellingClub Engineering" processRef="Proc_POOL_ENG"/>
    <bpmn:participant id="Part_POOL_MON" name="Monitoring System"/>
    <bpmn:messageFlow id="Msg_p2_upgrade_0" name="Dependabot / CVE webhook" sourceRef="Part_POOL_MON" targetRef="EVT_START_PR"/>
    <bpmn:messageFlow id="Msg_p2_upgrade_1" name="Health-check results" sourceRef="TASK_SMOKE_PROD" targetRef="Part_POOL_MON"/>
    <bpmn:messageFlow id="Msg_p2_upgrade_2" name="Rollback incident signal" sourceRef="TASK_ALERT_ROLL" targetRef="Part_POOL_MON"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_POOL_ENG" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POOL_ENG">
      <bpmn:lane id="Lane_POOL_ENG_0" name="Developer"><bpmn:flowNodeRef>EVT_START_PR</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_ASSESS</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_SEVERITY</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_EXPEDITE</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_SCHEDULE</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_FIX_PATCH</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_NOTIFY_DEV</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_ALERT_ROLL</bpmn:flowNodeRef><bpmn:flowNodeRef>EVT_END_OK</bpmn:flowNodeRef><bpmn:flowNodeRef>EVT_END_ROLL</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_ENG_1" name="DevOps"><bpmn:flowNodeRef>TASK_STAGE_DEP</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_STAGE_TEST</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_STAGE_OK</bpmn:flowNodeRef><bpmn:flowNodeRef>EVT_MAINT_WIN</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_PROD_DEP</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_PROD_OK</bpmn:flowNodeRef><bpmn:flowNodeRef>TASK_ROLLBACK</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_ENG_2" name="System"><bpmn:flowNodeRef>TASK_SMOKE_PROD</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="EVT_START_PR" name="Dependabot PR / CVE alert received"><bpmn:messageEventDefinition/></bpmn:startEvent>
    <bpmn:businessRuleTask id="TASK_ASSESS" name="Assess severity &amp; impact (CVSS, deps tree)"/>
    <bpmn:exclusiveGateway id="GW_SEVERITY" name="Severity level?"/>
    <bpmn:userTask id="TASK_EXPEDITE" name="Trigger expedited patch track"/>
    <bpmn:userTask id="TASK_SCHEDULE" name="Add to routine patch queue"/>
    <bpmn:serviceTask id="TASK_STAGE_DEP" name="Deploy patch to staging (CI)"/>
    <bpmn:serviceTask id="TASK_STAGE_TEST" name="Run smoke &amp; integration tests"/>
    <bpmn:exclusiveGateway id="GW_STAGE_OK" name="Staging tests passed?"/>
    <bpmn:userTask id="TASK_FIX_PATCH" name="Fix / pin version"/>
    <bpmn:intermediateCatchEvent id="EVT_MAINT_WIN" name="Await maintenance window"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="TASK_PROD_DEP" name="Deploy to production (rolling restart)"/>
    <bpmn:serviceTask id="TASK_SMOKE_PROD" name="Production smoke tests &amp; actuator health"/>
    <bpmn:exclusiveGateway id="GW_PROD_OK" name="Smoke tests passed?"/>
    <bpmn:serviceTask id="TASK_ROLLBACK" name="Rollback: redeploy previous jar / bundle"/>
    <bpmn:sendTask id="TASK_NOTIFY_DEV" name="Notify team: upgrade complete"/>
    <bpmn:sendTask id="TASK_ALERT_ROLL" name="Alert team: rollback executed"/>
    <bpmn:endEvent id="EVT_END_OK" name="Upgrade applied"></bpmn:endEvent>
    <bpmn:endEvent id="EVT_END_ROLL" name="Rollback complete — patch deferred"><bpmn:errorEventDefinition/></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_0" sourceRef="EVT_START_PR" targetRef="TASK_ASSESS"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_1" sourceRef="TASK_ASSESS" targetRef="GW_SEVERITY"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_2" name="critical (CVSS ≥ 7.0)" sourceRef="GW_SEVERITY" targetRef="TASK_EXPEDITE"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_3" name="routine (CVSS &lt; 7.0)" sourceRef="GW_SEVERITY" targetRef="TASK_SCHEDULE"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_4" sourceRef="TASK_EXPEDITE" targetRef="TASK_STAGE_DEP"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_5" sourceRef="TASK_SCHEDULE" targetRef="TASK_STAGE_DEP"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_6" sourceRef="TASK_STAGE_DEP" targetRef="TASK_STAGE_TEST"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_7" sourceRef="TASK_STAGE_TEST" targetRef="GW_STAGE_OK"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_8" name="passed" sourceRef="GW_STAGE_OK" targetRef="EVT_MAINT_WIN"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_9" name="failed" sourceRef="GW_STAGE_OK" targetRef="TASK_FIX_PATCH"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_10" sourceRef="TASK_FIX_PATCH" targetRef="TASK_STAGE_DEP"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_11" sourceRef="EVT_MAINT_WIN" targetRef="TASK_PROD_DEP"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_12" sourceRef="TASK_PROD_DEP" targetRef="TASK_SMOKE_PROD"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_13" sourceRef="TASK_SMOKE_PROD" targetRef="GW_PROD_OK"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_14" name="passed" sourceRef="GW_PROD_OK" targetRef="TASK_NOTIFY_DEV"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_15" name="failed" sourceRef="GW_PROD_OK" targetRef="TASK_ROLLBACK"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_16" sourceRef="TASK_NOTIFY_DEV" targetRef="EVT_END_OK"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_17" sourceRef="TASK_ROLLBACK" targetRef="TASK_ALERT_ROLL"/>
    <bpmn:sequenceFlow id="Flow_p2_upgrade_18" sourceRef="TASK_ALERT_ROLL" targetRef="EVT_END_ROLL"/>
    <bpmn:dataObject id="OBJ_DO_CVE"/>
    <bpmn:dataObjectReference id="DO_CVE" name="CVE / Dependabot report" dataObjectRef="OBJ_DO_CVE"/>
    <bpmn:association id="Assoc_DO_CVE" sourceRef="TASK_ASSESS" targetRef="DO_CVE"/>
    <bpmn:dataObject id="OBJ_DO_PREV"/>
    <bpmn:dataObjectReference id="DO_PREV" name="Previous build ref" dataObjectRef="OBJ_DO_PREV"/>
    <bpmn:association id="Assoc_DO_PREV" sourceRef="TASK_ROLLBACK" targetRef="DO_PREV"/>
    <bpmn:textAnnotation id="Anno_POOL_ENG_0"><bpmn:text>Critical: next available slot; routine: Sat 03:00</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_ENG_0" sourceRef="EVT_MAINT_WIN" targetRef="Anno_POOL_ENG_0"/>
    <bpmn:textAnnotation id="Anno_POOL_ENG_1"><bpmn:text>Loop back: pin version / workaround, re-enter staging</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_ENG_1" sourceRef="TASK_FIX_PATCH" targetRef="Anno_POOL_ENG_1"/>
  </bpmn:process>
