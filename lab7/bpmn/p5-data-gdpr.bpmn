<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p5_data_gdpr" targetNamespace="http://modellingclub.local/bpmn" exporter="ModellingClub Lab7 generator" exporterVersion="1.0">
  <bpmn:dataStore id="STORE_DS_LIVE" name="Live DB"/>
  <bpmn:dataStore id="STORE_DS_AUDIT" name="Audit log"/>
  <bpmn:collaboration id="Collab_p5_data_gdpr">
    <bpmn:participant id="Part_POOL_SYS" name="ModellingClub System" processRef="Proc_POOL_SYS"/>
    <bpmn:participant id="Part_POOL_MEMBER" name="Member"/>
    <bpmn:participant id="Part_POOL_ARCHIVE" name="Archive Store"/>
    <bpmn:messageFlow id="Msg_p5_data_gdpr_0" name="GDPR request submission" sourceRef="Part_POOL_MEMBER" targetRef="START_GDPR"/>
    <bpmn:messageFlow id="Msg_p5_data_gdpr_1" name="Export ZIP download link" sourceRef="ZIP_SEND" targetRef="Part_POOL_MEMBER"/>
    <bpmn:messageFlow id="Msg_p5_data_gdpr_2" name="Erasure confirmation" sourceRef="CONFIRM_ERASURE" targetRef="Part_POOL_MEMBER"/>
    <bpmn:messageFlow id="Msg_p5_data_gdpr_3" name="Legal-hold notification" sourceRef="NOTIFY_HOLD" targetRef="Part_POOL_MEMBER"/>
    <bpmn:messageFlow id="Msg_p5_data_gdpr_4" name="Stale record batch" sourceRef="ARCHIVE_COLD" targetRef="Part_POOL_ARCHIVE"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_POOL_SYS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POOL_SYS">
      <bpmn:lane id="Lane_POOL_SYS_0" name="Retention Job"><bpmn:flowNodeRef>START_TIMER</bpmn:flowNodeRef><bpmn:flowNodeRef>IDENTIFY_STALE</bpmn:flowNodeRef><bpmn:flowNodeRef>ARCHIVE_COLD</bpmn:flowNodeRef><bpmn:flowNodeRef>PURGE_LIVE</bpmn:flowNodeRef><bpmn:flowNodeRef>AUDIT_RETENTION</bpmn:flowNodeRef><bpmn:flowNodeRef>END_RETENTION</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_SYS_1" name="GDPR Handler"><bpmn:flowNodeRef>START_GDPR</bpmn:flowNodeRef><bpmn:flowNodeRef>VERIFY_IDENTITY</bpmn:flowNodeRef><bpmn:flowNodeRef>BND_30D</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_REQ_TYPE</bpmn:flowNodeRef><bpmn:flowNodeRef>BUILD_EXPORT</bpmn:flowNodeRef><bpmn:flowNodeRef>ZIP_SEND</bpmn:flowNodeRef><bpmn:flowNodeRef>END_EXPORT</bpmn:flowNodeRef><bpmn:flowNodeRef>HARD_DELETE</bpmn:flowNodeRef><bpmn:flowNodeRef>CONFIRM_ERASURE</bpmn:flowNodeRef><bpmn:flowNodeRef>AUDIT_GDPR</bpmn:flowNodeRef><bpmn:flowNodeRef>END_ERASURE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_SYS_2" name="DPO Review"><bpmn:flowNodeRef>DPO_REVIEW</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_LEGAL_HOLD</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_HOLD_HALT</bpmn:flowNodeRef><bpmn:flowNodeRef>NOTIFY_HOLD</bpmn:flowNodeRef><bpmn:flowNodeRef>END_HOLD</bpmn:flowNodeRef><bpmn:flowNodeRef>ANONYMISE</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START_TIMER" name="Nightly retention schedule"><bpmn:timerEventDefinition/></bpmn:startEvent>
    <bpmn:serviceTask id="IDENTIFY_STALE" name="Identify stale records"/>
    <bpmn:serviceTask id="ARCHIVE_COLD" name="Archive records to cold storage"/>
    <bpmn:serviceTask id="PURGE_LIVE" name="Purge stale records from live DB"/>
    <bpmn:scriptTask id="AUDIT_RETENTION" name="Write retention audit entry"/>
    <bpmn:endEvent id="END_RETENTION" name="Retention cycle complete"></bpmn:endEvent>
    <bpmn:startEvent id="START_GDPR" name="GDPR request received"><bpmn:messageEventDefinition/></bpmn:startEvent>
    <bpmn:serviceTask id="VERIFY_IDENTITY" name="Verify member identity (JWT + username)"/>
    <bpmn:boundaryEvent id="BND_30D" name="30-day deadline" attachedToRef="VERIFY_IDENTITY" cancelActivity="false"><bpmn:timerEventDefinition/></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_REQ_TYPE" name="Export or deletion?"/>
    <bpmn:serviceTask id="BUILD_EXPORT" name="Compile profile + builds + comments"/>
    <bpmn:sendTask id="ZIP_SEND" name="Generate ZIP; notify member"/>
    <bpmn:endEvent id="END_EXPORT" name="Data export delivered"><bpmn:messageEventDefinition/></bpmn:endEvent>
    <bpmn:manualTask id="DPO_REVIEW" name="DPO reviews deletion request"/>
    <bpmn:exclusiveGateway id="GW_LEGAL_HOLD" name="Legal hold required?"/>
    <bpmn:exclusiveGateway id="GW_HOLD_HALT" name="Partial erasure allowed?"/>
    <bpmn:sendTask id="NOTIFY_HOLD" name="Notify member of legal hold"/>
    <bpmn:endEvent id="END_HOLD" name="Parked pending hold"></bpmn:endEvent>
    <bpmn:scriptTask id="ANONYMISE" name="Anonymise retained tx records"/>
    <bpmn:serviceTask id="HARD_DELETE" name="Hard-delete member data"/>
    <bpmn:sendTask id="CONFIRM_ERASURE" name="Send erasure confirmation"/>
    <bpmn:scriptTask id="AUDIT_GDPR" name="Write GDPR audit entry"/>
    <bpmn:endEvent id="END_ERASURE" name="Erasure complete"><bpmn:messageEventDefinition/></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_0" sourceRef="START_TIMER" targetRef="IDENTIFY_STALE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_1" sourceRef="IDENTIFY_STALE" targetRef="ARCHIVE_COLD"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_2" sourceRef="ARCHIVE_COLD" targetRef="PURGE_LIVE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_3" sourceRef="PURGE_LIVE" targetRef="AUDIT_RETENTION"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_4" sourceRef="AUDIT_RETENTION" targetRef="END_RETENTION"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_5" sourceRef="START_GDPR" targetRef="VERIFY_IDENTITY"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_6" sourceRef="VERIFY_IDENTITY" targetRef="GW_REQ_TYPE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_7" name="export" sourceRef="GW_REQ_TYPE" targetRef="BUILD_EXPORT"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_8" name="deletion" sourceRef="GW_REQ_TYPE" targetRef="DPO_REVIEW"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_9" sourceRef="BUILD_EXPORT" targetRef="ZIP_SEND"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_10" sourceRef="ZIP_SEND" targetRef="END_EXPORT"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_11" sourceRef="DPO_REVIEW" targetRef="GW_LEGAL_HOLD"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_12" name="no hold" sourceRef="GW_LEGAL_HOLD" targetRef="ANONYMISE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_13" name="hold exists" sourceRef="GW_LEGAL_HOLD" targetRef="GW_HOLD_HALT"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_14" name="partial OK" sourceRef="GW_HOLD_HALT" targetRef="ANONYMISE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_15" name="full hold" sourceRef="GW_HOLD_HALT" targetRef="NOTIFY_HOLD"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_16" sourceRef="NOTIFY_HOLD" targetRef="END_HOLD"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_17" sourceRef="ANONYMISE" targetRef="HARD_DELETE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_18" sourceRef="HARD_DELETE" targetRef="CONFIRM_ERASURE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_19" sourceRef="CONFIRM_ERASURE" targetRef="AUDIT_GDPR"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_20" sourceRef="AUDIT_GDPR" targetRef="END_ERASURE"/>
    <bpmn:sequenceFlow id="Flow_p5_data_gdpr_21" name="deadline breach" sourceRef="BND_30D" targetRef="CONFIRM_ERASURE"/>
    <bpmn:dataStoreReference id="DS_LIVE" name="Live DB" dataStoreRef="STORE_DS_LIVE"/>
    <bpmn:association id="Assoc_DS_LIVE" sourceRef="IDENTIFY_STALE" targetRef="DS_LIVE"/>
    <bpmn:dataObject id="OBJ_DO_ZIP"/>
    <bpmn:dataObjectReference id="DO_ZIP" name="member-data.zip" dataObjectRef="OBJ_DO_ZIP"/>
    <bpmn:association id="Assoc_DO_ZIP" sourceRef="ZIP_SEND" targetRef="DO_ZIP"/>
    <bpmn:dataStoreReference id="DS_AUDIT" name="Audit log" dataStoreRef="STORE_DS_AUDIT"/>
    <bpmn:association id="Assoc_DS_AUDIT" sourceRef="AUDIT_GDPR" targetRef="DS_AUDIT"/>
    <bpmn:textAnnotation id="Anno_POOL_SYS_0"><bpmn:text>GDPR Art. 12 — respond within 30 days</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_SYS_0" sourceRef="BND_30D" targetRef="Anno_POOL_SYS_0"/>
    <bpmn:textAnnotation id="Anno_POOL_SYS_1"><bpmn:text>Marketplace tx records anonymised, not deleted</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_SYS_1" sourceRef="ANONYMISE" targetRef="Anno_POOL_SYS_1"/>
  </bpmn:process>
