      <bpmndi:BPMNShape id="DI_Lane_POOL_CICD_0" bpmnElement="Lane_POOL_CICD_0" isHorizontal="true"><dc:Bounds x="40" y="10" width="4362" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_POOL_CICD_1" bpmnElement="Lane_POOL_CICD_1" isHorizontal="true"><dc:Bounds x="40" y="150" width="4362" height="344"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_POOL_CICD_2" bpmnElement="Lane_POOL_CICD_2" isHorizontal="true"><dc:Bounds x="40" y="494" width="4362" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_POOL_CICD_3" bpmnElement="Lane_POOL_CICD_3" isHorizontal="true"><dc:Bounds x="40" y="634" width="4362" height="232"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_POOL_CICD_4" bpmnElement="Lane_POOL_CICD_4" isHorizontal="true"><dc:Bounds x="40" y="866" width="4362" height="344"/></bpmndi:BPMNShape>
