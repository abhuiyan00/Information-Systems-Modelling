      <bpmndi:BPMNShape id="DI_Anno_POOL_CICD_1" bpmnElement="Anno_POOL_CICD_1"><dc:Bounds x="3850" y="1128" width="150" height="44"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_0" bpmnElement="Flow_p3_cicd_0"><di:waypoint x="183" y="220"/><di:waypoint x="327" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_1" bpmnElement="Flow_p3_cicd_1"><di:waypoint x="379" y="220"/><di:waypoint x="476" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_2" bpmnElement="Flow_p3_cicd_2"><di:waypoint x="379" y="220"/><di:waypoint x="428" y="220"/><di:waypoint x="428" y="332"/><di:waypoint x="476" y="332"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_3" bpmnElement="Flow_p3_cicd_3"><di:waypoint x="606" y="220"/><di:waypoint x="703" y="220"/></bpmndi:BPMNEdge>
