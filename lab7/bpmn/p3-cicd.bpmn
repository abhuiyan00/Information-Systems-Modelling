      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_7" bpmnElement="Flow_p3_cicd_7"><di:waypoint x="943" y="220"/><di:waypoint x="992" y="220"/><di:waypoint x="992" y="332"/><di:waypoint x="1040" y="332"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_8" bpmnElement="Flow_p3_cicd_8"><di:waypoint x="1170" y="220"/><di:waypoint x="1267" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_9" bpmnElement="Flow_p3_cicd_9"><di:waypoint x="1170" y="332"/><di:waypoint x="1219" y="332"/><di:waypoint x="1219" y="220"/><di:waypoint x="1267" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_Flow_p3_cicd_10" bpmnElement="Flow_p3_cicd_10"><di:waypoint x="1319" y="220"/><di:waypoint x="1455" y="220"/></bpmndi:BPMNEdge>
