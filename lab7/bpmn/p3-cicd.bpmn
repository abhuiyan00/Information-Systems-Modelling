<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p3_cicd" targetNamespace="http://modellingclub.local/bpmn" exporter="ModellingClub Lab7 generator" exporterVersion="1.0">
  <bpmn:dataStore id="STORE_DS_ART" name="Artifact registry"/>
  <bpmn:collaboration id="Collab_p3_cicd">
    <bpmn:participant id="Part_POOL_CICD" name="ModellingClub CI/CD" processRef="Proc_POOL_CICD"/>
    <bpmn:participant id="Part_POOL_STG" name="Staging Environment"/>
    <bpmn:participant id="Part_POOL_PRD" name="Production Environment"/>
    <bpmn:messageFlow id="Msg_p3_cicd_0" name="Deploy artifact to staging" sourceRef="DEPLOY_STAGING" targetRef="Part_POOL_STG"/>
    <bpmn:messageFlow id="Msg_p3_cicd_1" name="Staging ready" sourceRef="Part_POOL_STG" targetRef="STAGING_SMOKE"/>
    <bpmn:messageFlow id="Msg_p3_cicd_2" name="Deploy green slot" sourceRef="DEPLOY_GREEN" targetRef="Part_POOL_PRD"/>
    <bpmn:messageFlow id="Msg_p3_cicd_3" name="Switch nginx upstream to green" sourceRef="SWITCH_TRAFFIC" targetRef="Part_POOL_PRD"/>
    <bpmn:messageFlow id="Msg_p3_cicd_4" name="Traffic live on green" sourceRef="Part_POOL_PRD" targetRef="POST_SMOKE"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_POOL_CICD" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POOL_CICD">
      <bpmn:lane id="Lane_POOL_CICD_0" name="Developer"><bpmn:flowNodeRef>FIX_NOTIFY</bpmn:flowNodeRef><bpmn:flowNodeRef>FIX_CODE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_CICD_1" name="CI Pipeline"><bpmn:flowNodeRef>MSG_START</bpmn:flowNodeRef><bpmn:flowNodeRef>PAR_BUILD_SPLIT</bpmn:flowNodeRef><bpmn:flowNodeRef>BUILD_BACKEND</bpmn:flowNodeRef><bpmn:flowNodeRef>BUILD_FRONTEND</bpmn:flowNodeRef><bpmn:flowNodeRef>PAR_BUILD_JOIN</bpmn:flowNodeRef><bpmn:flowNodeRef>PAR_TEST_SPLIT</bpmn:flowNodeRef><bpmn:flowNodeRef>TEST_BACKEND</bpmn:flowNodeRef><bpmn:flowNodeRef>TEST_FRONTEND</bpmn:flowNodeRef><bpmn:flowNodeRef>PAR_TEST_JOIN</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_TESTS_PASS</bpmn:flowNodeRef><bpmn:flowNodeRef>PUBLISH_ARTIFACTS</bpmn:flowNodeRef><bpmn:flowNodeRef>DEPLOY_STAGING</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_CICD_2" name="QA / Tester"><bpmn:flowNodeRef>STAGING_SMOKE</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_STAGING_OK</bpmn:flowNodeRef><bpmn:flowNodeRef>POST_SMOKE</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_POST_SMOKE</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_CICD_3" name="Release Manager"><bpmn:flowNodeRef>APPROVAL_GATE</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_APPROVED</bpmn:flowNodeRef><bpmn:flowNodeRef>REJECT_NOTIFY</bpmn:flowNodeRef><bpmn:flowNodeRef>END_REJECTED</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_CICD_4" name="Ops / DevOps"><bpmn:flowNodeRef>DEPLOY_GREEN</bpmn:flowNodeRef><bpmn:flowNodeRef>HEALTH_CHECK</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_HEALTH</bpmn:flowNodeRef><bpmn:flowNodeRef>SWITCH_TRAFFIC</bpmn:flowNodeRef><bpmn:flowNodeRef>ROLLBACK</bpmn:flowNodeRef><bpmn:flowNodeRef>ROLLBACK_NOTIFY</bpmn:flowNodeRef><bpmn:flowNodeRef>END_ROLLBACK</bpmn:flowNodeRef><bpmn:flowNodeRef>END_SUCCESS</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="MSG_START" name="Push to main received"><bpmn:messageEventDefinition/></bpmn:startEvent>
    <bpmn:parallelGateway id="PAR_BUILD_SPLIT" name="Split: build"/>
    <bpmn:serviceTask id="BUILD_BACKEND" name="mvn package (build jar)"/>
    <bpmn:serviceTask id="BUILD_FRONTEND" name="ng build (SSR bundle)"/>
    <bpmn:parallelGateway id="PAR_BUILD_JOIN" name="Join: artifacts ready"/>
    <bpmn:parallelGateway id="PAR_TEST_SPLIT" name="Split: tests"/>
    <bpmn:serviceTask id="TEST_BACKEND" name="mvn test (JUnit / Spring)"/>
    <bpmn:serviceTask id="TEST_FRONTEND" name="npm test + tsc --noEmit"/>
    <bpmn:parallelGateway id="PAR_TEST_JOIN" name="Join: tests done"/>
    <bpmn:exclusiveGateway id="GW_TESTS_PASS" name="All tests passed?"/>
    <bpmn:sendTask id="FIX_NOTIFY" name="Notify developer: failure"/>
    <bpmn:userTask id="FIX_CODE" name="Fix failing tests / code"/>
    <bpmn:serviceTask id="PUBLISH_ARTIFACTS" name="Publish jar + bundle to registry"/>
    <bpmn:serviceTask id="DEPLOY_STAGING" name="Deploy to staging"/>
    <bpmn:manualTask id="STAGING_SMOKE" name="Run staging smoke tests"/>
    <bpmn:exclusiveGateway id="GW_STAGING_OK" name="Staging smoke passed?"/>
    <bpmn:userTask id="APPROVAL_GATE" name="Review notes; approve / reject"/>
    <bpmn:exclusiveGateway id="GW_APPROVED" name="Release approved?"/>
    <bpmn:sendTask id="REJECT_NOTIFY" name="Notify team: rejected"/>
    <bpmn:endEvent id="END_REJECTED" name="Release rejected"></bpmn:endEvent>
    <bpmn:serviceTask id="DEPLOY_GREEN" name="Deploy to green slot (idle)"/>
    <bpmn:serviceTask id="HEALTH_CHECK" name="Actuator /health on green"/>
    <bpmn:exclusiveGateway id="GW_HEALTH" name="Green healthy?"/>
    <bpmn:serviceTask id="SWITCH_TRAFFIC" name="nginx: switch traffic to green"/>
    <bpmn:manualTask id="POST_SMOKE" name="Post-deploy production smoke"/>
    <bpmn:exclusiveGateway id="GW_POST_SMOKE" name="Post-deploy smoke passed?"/>
    <bpmn:serviceTask id="ROLLBACK" name="Rollback: nginx back to blue"/>
    <bpmn:sendTask id="ROLLBACK_NOTIFY" name="Notify team: rollback executed"/>
    <bpmn:endEvent id="END_ROLLBACK" name="Rolled back to blue"></bpmn:endEvent>
    <bpmn:endEvent id="END_SUCCESS" name="Deployment successful"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p3_cicd_0" sourceRef="MSG_START" targetRef="PAR_BUILD_SPLIT"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_1" sourceRef="PAR_BUILD_SPLIT" targetRef="BUILD_BACKEND"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_2" sourceRef="PAR_BUILD_SPLIT" targetRef="BUILD_FRONTEND"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_3" sourceRef="BUILD_BACKEND" targetRef="PAR_BUILD_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_4" sourceRef="BUILD_FRONTEND" targetRef="PAR_BUILD_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_5" sourceRef="PAR_BUILD_JOIN" targetRef="PAR_TEST_SPLIT"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_6" sourceRef="PAR_TEST_SPLIT" targetRef="TEST_BACKEND"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_7" sourceRef="PAR_TEST_SPLIT" targetRef="TEST_FRONTEND"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_8" sourceRef="TEST_BACKEND" targetRef="PAR_TEST_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_9" sourceRef="TEST_FRONTEND" targetRef="PAR_TEST_JOIN"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_10" sourceRef="PAR_TEST_JOIN" targetRef="GW_TESTS_PASS"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_11" name="all passed" sourceRef="GW_TESTS_PASS" targetRef="PUBLISH_ARTIFACTS"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_12" name="one or more failed" sourceRef="GW_TESTS_PASS" targetRef="FIX_NOTIFY"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_13" sourceRef="FIX_NOTIFY" targetRef="FIX_CODE"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_14" sourceRef="FIX_CODE" targetRef="PAR_BUILD_SPLIT"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_15" sourceRef="PUBLISH_ARTIFACTS" targetRef="DEPLOY_STAGING"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_16" sourceRef="DEPLOY_STAGING" targetRef="STAGING_SMOKE"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_17" sourceRef="STAGING_SMOKE" targetRef="GW_STAGING_OK"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_18" name="passed" sourceRef="GW_STAGING_OK" targetRef="APPROVAL_GATE"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_19" name="failed" sourceRef="GW_STAGING_OK" targetRef="FIX_NOTIFY"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_20" sourceRef="APPROVAL_GATE" targetRef="GW_APPROVED"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_21" name="approved" sourceRef="GW_APPROVED" targetRef="DEPLOY_GREEN"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_22" name="rejected" sourceRef="GW_APPROVED" targetRef="REJECT_NOTIFY"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_23" sourceRef="REJECT_NOTIFY" targetRef="END_REJECTED"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_24" sourceRef="DEPLOY_GREEN" targetRef="HEALTH_CHECK"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_25" sourceRef="HEALTH_CHECK" targetRef="GW_HEALTH"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_26" name="passed" sourceRef="GW_HEALTH" targetRef="SWITCH_TRAFFIC"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_27" name="failed" sourceRef="GW_HEALTH" targetRef="ROLLBACK"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_28" sourceRef="SWITCH_TRAFFIC" targetRef="POST_SMOKE"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_29" sourceRef="POST_SMOKE" targetRef="GW_POST_SMOKE"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_30" name="passed" sourceRef="GW_POST_SMOKE" targetRef="END_SUCCESS"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_31" name="failed" sourceRef="GW_POST_SMOKE" targetRef="ROLLBACK"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_32" sourceRef="ROLLBACK" targetRef="ROLLBACK_NOTIFY"/>
    <bpmn:sequenceFlow id="Flow_p3_cicd_33" sourceRef="ROLLBACK_NOTIFY" targetRef="END_ROLLBACK"/>
    <bpmn:dataStoreReference id="DS_ART" name="Artifact registry" dataStoreRef="STORE_DS_ART"/>
    <bpmn:association id="Assoc_DS_ART" sourceRef="PUBLISH_ARTIFACTS" targetRef="DS_ART"/>
    <bpmn:dataObject id="OBJ_DO_NOTES"/>
    <bpmn:dataObjectReference id="DO_NOTES" name="Release notes" dataObjectRef="OBJ_DO_NOTES"/>
    <bpmn:association id="Assoc_DO_NOTES" sourceRef="APPROVAL_GATE" targetRef="DO_NOTES"/>
    <bpmn:textAnnotation id="Anno_POOL_CICD_0"><bpmn:text>Green slot idle; blue keeps serving traffic</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_CICD_0" sourceRef="DEPLOY_GREEN" targetRef="Anno_POOL_CICD_0"/>
    <bpmn:textAnnotation id="Anno_POOL_CICD_1"><bpmn:text>Blue still running — nginx reverts, zero downtime</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_CICD_1" sourceRef="ROLLBACK" targetRef="Anno_POOL_CICD_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_p3_cicd">
    <bpmndi:BPMNPlane id="Plane_p3_cicd" bpmnElement="Collab_p3_cicd">
      <bpmndi:BPMNShape id="DI_Part_POOL_CICD" bpmnElement="Part_POOL_CICD" isHorizontal="true"><dc:Bounds x="10" y="10" width="4392" height="1200"/></bpmndi:BPMNShape>
