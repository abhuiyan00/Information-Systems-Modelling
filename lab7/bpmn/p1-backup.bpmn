      <bpmndi:BPMNEdge id="DI_AnnoAssoc_POOL_OPS_1" bpmnElement="AnnoAssoc_POOL_OPS_1"><di:waypoint x="1857" y="676"/><di:waypoint x="2025" y="778"/></bpmndi:BPMNEdge>
