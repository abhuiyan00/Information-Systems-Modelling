<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_p4_migration" targetNamespace="http://modellingclub.local/bpmn" exporter="ModellingClub Lab7 generator" exporterVersion="1.0">
  <bpmn:dataStore id="STORE_DS_RUNBOOK" name="Migration runbook"/>
  <bpmn:collaboration id="Collab_p4_migration">
    <bpmn:participant id="Part_POOL_MIG" name="ModellingClub Migration Team" processRef="Proc_POOL_MIG"/>
    <bpmn:participant id="Part_POOL_USERS" name="Users"/>
    <bpmn:participant id="Part_POOL_PRD" name="Production Environment"/>
    <bpmn:messageFlow id="Msg_p4_migration_0" name="Scheduled maintenance notice" sourceRef="NOTIFY_USERS" targetRef="Part_POOL_USERS"/>
    <bpmn:messageFlow id="Msg_p4_migration_1" name="Activate maintenance page" sourceRef="MAINT_MODE" targetRef="Part_POOL_PRD"/>
    <bpmn:messageFlow id="Msg_p4_migration_2" name="Restart with Postgres datasource" sourceRef="SWITCH_DS" targetRef="Part_POOL_PRD"/>
    <bpmn:messageFlow id="Msg_p4_migration_3" name="Deactivate maintenance mode" sourceRef="DISABLE_MAINT" targetRef="Part_POOL_PRD"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_POOL_MIG" isExecutable="false">
    <bpmn:laneSet id="LaneSet_POOL_MIG">
      <bpmn:lane id="Lane_POOL_MIG_0" name="Developer"><bpmn:flowNodeRef>PREP_CODE</bpmn:flowNodeRef><bpmn:flowNodeRef>TEST_CONTAINERS</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_TC_PASS</bpmn:flowNodeRef><bpmn:flowNodeRef>FIX_SQL</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_MIG_1" name="DBA"><bpmn:flowNodeRef>GEN_BASELINE</bpmn:flowNodeRef><bpmn:flowNodeRef>DUMP_H2</bpmn:flowNodeRef><bpmn:flowNodeRef>LOAD_PG</bpmn:flowNodeRef><bpmn:flowNodeRef>VERIFY_Q</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_VERIFY</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_MIG_2" name="Release Manager"><bpmn:flowNodeRef>START_APPROVAL</bpmn:flowNodeRef><bpmn:flowNodeRef>SCHED_WINDOW</bpmn:flowNodeRef><bpmn:flowNodeRef>NOTIFY_USERS</bpmn:flowNodeRef><bpmn:flowNodeRef>SIGNOFF</bpmn:flowNodeRef><bpmn:flowNodeRef>END_SUCCESS</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_MIG_3" name="Ops / DevOps"><bpmn:flowNodeRef>TIMER_WINDOW</bpmn:flowNodeRef><bpmn:flowNodeRef>MAINT_MODE</bpmn:flowNodeRef><bpmn:flowNodeRef>PROVISION_PG</bpmn:flowNodeRef><bpmn:flowNodeRef>SWITCH_DS</bpmn:flowNodeRef><bpmn:flowNodeRef>DISABLE_MAINT</bpmn:flowNodeRef><bpmn:flowNodeRef>ROLLBACK_DS</bpmn:flowNodeRef><bpmn:flowNodeRef>ROLLBACK_NOTIFY</bpmn:flowNodeRef><bpmn:flowNodeRef>DISABLE_MAINT_RB</bpmn:flowNodeRef><bpmn:flowNodeRef>END_ROLLBACK</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_POOL_MIG_4" name="QA / Tester"><bpmn:flowNodeRef>SMOKE_TEST</bpmn:flowNodeRef><bpmn:flowNodeRef>GW_SMOKE</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="START_APPROVAL" name="Migration approved"></bpmn:startEvent>
    <bpmn:serviceTask id="PREP_CODE" name="Add Postgres driver + Flyway"/>
    <bpmn:scriptTask id="GEN_BASELINE" name="Export H2 schema → V1__baseline.sql"/>
    <bpmn:serviceTask id="TEST_CONTAINERS" name="Integration test (Testcontainers)"/>
    <bpmn:exclusiveGateway id="GW_TC_PASS" name="Tests passed?"/>
    <bpmn:userTask id="FIX_SQL" name="Fix SQL dialect issues"/>
    <bpmn:userTask id="SCHED_WINDOW" name="Schedule maintenance window"/>
    <bpmn:sendTask id="NOTIFY_USERS" name="Send maintenance notice"/>
    <bpmn:intermediateCatchEvent id="TIMER_WINDOW" name="Wait for window start"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="MAINT_MODE" name="Enable maintenance / read-only mode"/>
    <bpmn:scriptTask id="DUMP_H2" name="Dump H2 data (FK-safe order)"/>
    <bpmn:serviceTask id="PROVISION_PG" name="Provision Postgres; schema + roles"/>
    <bpmn:scriptTask id="LOAD_PG" name="Load dump; run Flyway migrate"/>
    <bpmn:serviceTask id="SWITCH_DS" name="Switch datasource; ddl-auto=validate"/>
    <bpmn:scriptTask id="VERIFY_Q" name="Verification queries (counts, FKs)"/>
    <bpmn:exclusiveGateway id="GW_VERIFY" name="Verification passed?"/>
    <bpmn:manualTask id="SMOKE_TEST" name="Post-migration smoke test"/>
    <bpmn:exclusiveGateway id="GW_SMOKE" name="Smoke passed?"/>
    <bpmn:serviceTask id="DISABLE_MAINT" name="Disable maintenance; restore traffic"/>
    <bpmn:userTask id="SIGNOFF" name="Sign off; archive runbook"/>
    <bpmn:endEvent id="END_SUCCESS" name="Migration complete"></bpmn:endEvent>
    <bpmn:serviceTask id="ROLLBACK_DS" name="Revert datasource to H2; restart"/>
    <bpmn:sendTask id="ROLLBACK_NOTIFY" name="Notify team: rolled back to H2"/>
    <bpmn:serviceTask id="DISABLE_MAINT_RB" name="Disable maintenance (rollback)"/>
    <bpmn:endEvent id="END_ROLLBACK" name="Rolled back to H2"></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p4_migration_0" sourceRef="START_APPROVAL" targetRef="PREP_CODE"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_1" sourceRef="PREP_CODE" targetRef="GEN_BASELINE"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_2" sourceRef="GEN_BASELINE" targetRef="TEST_CONTAINERS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_3" sourceRef="TEST_CONTAINERS" targetRef="GW_TC_PASS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_4" name="passed" sourceRef="GW_TC_PASS" targetRef="SCHED_WINDOW"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_5" name="failed" sourceRef="GW_TC_PASS" targetRef="FIX_SQL"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_6" sourceRef="FIX_SQL" targetRef="GEN_BASELINE"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_7" sourceRef="SCHED_WINDOW" targetRef="NOTIFY_USERS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_8" sourceRef="NOTIFY_USERS" targetRef="TIMER_WINDOW"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_9" sourceRef="TIMER_WINDOW" targetRef="MAINT_MODE"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_10" sourceRef="MAINT_MODE" targetRef="DUMP_H2"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_11" sourceRef="DUMP_H2" targetRef="PROVISION_PG"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_12" sourceRef="PROVISION_PG" targetRef="LOAD_PG"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_13" sourceRef="LOAD_PG" targetRef="SWITCH_DS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_14" sourceRef="SWITCH_DS" targetRef="VERIFY_Q"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_15" sourceRef="VERIFY_Q" targetRef="GW_VERIFY"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_16" name="passed" sourceRef="GW_VERIFY" targetRef="SMOKE_TEST"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_17" name="failed" sourceRef="GW_VERIFY" targetRef="ROLLBACK_DS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_18" sourceRef="SMOKE_TEST" targetRef="GW_SMOKE"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_19" name="passed" sourceRef="GW_SMOKE" targetRef="DISABLE_MAINT"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_20" name="failed" sourceRef="GW_SMOKE" targetRef="ROLLBACK_DS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_21" sourceRef="DISABLE_MAINT" targetRef="SIGNOFF"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_22" sourceRef="SIGNOFF" targetRef="END_SUCCESS"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_23" sourceRef="ROLLBACK_DS" targetRef="ROLLBACK_NOTIFY"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_24" sourceRef="ROLLBACK_NOTIFY" targetRef="DISABLE_MAINT_RB"/>
    <bpmn:sequenceFlow id="Flow_p4_migration_25" sourceRef="DISABLE_MAINT_RB" targetRef="END_ROLLBACK"/>
    <bpmn:dataObject id="OBJ_DO_BASELINE"/>
    <bpmn:dataObjectReference id="DO_BASELINE" name="V1__baseline.sql" dataObjectRef="OBJ_DO_BASELINE"/>
    <bpmn:association id="Assoc_DO_BASELINE" sourceRef="GEN_BASELINE" targetRef="DO_BASELINE"/>
    <bpmn:dataObject id="OBJ_DO_DUMP"/>
    <bpmn:dataObjectReference id="DO_DUMP" name="H2 SQL dump" dataObjectRef="OBJ_DO_DUMP"/>
    <bpmn:association id="Assoc_DO_DUMP" sourceRef="DUMP_H2" targetRef="DO_DUMP"/>
    <bpmn:dataStoreReference id="DS_RUNBOOK" name="Migration runbook" dataStoreRef="STORE_DS_RUNBOOK"/>
    <bpmn:association id="Assoc_DS_RUNBOOK" sourceRef="SIGNOFF" targetRef="DS_RUNBOOK"/>
    <bpmn:textAnnotation id="Anno_POOL_MIG_0"><bpmn:text>UUID → uuid; TIMESTAMP → TIMESTAMPTZ</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_MIG_0" sourceRef="GEN_BASELINE" targetRef="Anno_POOL_MIG_0"/>
    <bpmn:textAnnotation id="Anno_POOL_MIG_1"><bpmn:text>H2 file untouched during migration</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="AnnoAssoc_POOL_MIG_1" sourceRef="ROLLBACK_DS" targetRef="Anno_POOL_MIG_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_p4_migration">
